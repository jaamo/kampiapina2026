---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const YT = "https://www.youtube.com/channel/UC2Prp3t7Ol-a041FXTyCzNQ";

const posts = [
  { date: "2022", title: "Tubeless-kulttiin liittyminen ja muut huonot päätökset", cat: "Huolto" },
  { date: "2021", title: "Kaldoaivi Ultra Trail — 130 km erämaata", cat: "Kilpailu" },
  { date: "2020", title: "Miksi fiksi on lopulta paras arkipyörä", cat: "Mielipide" },
  { date: "2020", title: "Talvipyöräilyn pieni ja epätieteellinen opas", cat: "Opas" },
  { date: "2019", title: "Randoällärit — 500 kilometrin unelma ja sen sulaminen", cat: "Tapahtuma" },
];
---

<Layout title="Blogi — Kampiapina" description="Vanha blogiarkisto. Ei enää päivity, mutta jutut jäävät talteen. Uudet jutut löytyvät nykyään videoina.">
  <div class="page">
    <Nav active="blogi" />

    <!-- header -->
    <div class="header">
      <div class="header__meta">
        <span class="badge">Arkisto</span>
        <span class="header__note">Ei enää päivity — mutta vanhat jutut jäävät talteen.</span>
      </div>
      <h1 class="header__title">Blogi</h1>
    </div>

    <!-- post list -->
    <div class="posts">
      {
        posts.map((post) => (
          <a href="#" class="post">
            <span class="post__date">{post.date}</span>
            <span class="post__title">{post.title}</span>
            <span class="post__cat">{post.cat}</span>
          </a>
        ))
      }
      <p class="posts__outro">
        Uudet jutut löytyvät nykyään videoina.{" "}
        <a href={YT} class="posts__link">Katso YouTubessa →</a>
      </p>
    </div>

    <Footer />
  </div>
</Layout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .header {
    padding: 64px 46px 40px;
    border-bottom: 1px solid rgba(237, 230, 210, 0.12);
  }
  .header__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .badge {
    border: 1px solid rgba(237, 230, 210, 0.25);
    color: #a8a488;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: 2px;
  }
  .header__note {
    color: #8f9270;
    font-size: 14px;
    font-weight: 500;
  }
  .header__title {
    font-weight: 900;
    font-size: 64px;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .posts {
    max-width: 820px;
    margin: 0;
    padding: 20px 46px 64px;
    flex: 1;
  }
  .post {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    align-items: baseline;
    gap: 28px;
    text-decoration: none;
    color: #ede6d2;
    padding: 24px 0;
    border-bottom: 1px solid rgba(237, 230, 210, 0.1);
    transition: color 0.15s ease;
  }
  .post:hover {
    color: #e2701b;
  }
  .post__date {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.06em;
    color: #8f9270;
  }
  .post__title {
    font-weight: 700;
    font-size: 19px;
    line-height: 1.3;
  }
  .post__cat {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8f9270;
    white-space: nowrap;
  }
  .posts__outro {
    margin: 34px 0 0;
    color: #8f9270;
    font-size: 14px;
    font-weight: 500;
  }
  .posts__link {
    color: #e2701b;
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .header {
      padding: 48px 24px 32px;
    }
    .header__title {
      font-size: 48px;
    }
    .posts {
      padding: 12px 24px 48px;
    }
    .post {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 20px 0;
    }
    .post__cat {
      color: #696c46;
    }
  }
</style>
