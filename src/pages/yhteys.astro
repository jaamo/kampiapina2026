---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const email = "jaakko@alajoki.fi";
---

<Layout title="Yhteys — Kampiapina" description="Laita viestiä Kampiapinalle. Sähköposti tavoittaa parhaiten: jaakko@alajoki.fi.">
  <Nav active="yhteys" />

  <!-- hero -->
  <div class="hero">
    <img src="/profiilikuva2024.jpg" alt="Jaakko Alajoki" class="hero__img" />
    <div class="hero__glow"></div>
    <div class="hero__inner">
      <div class="eyebrow">Yhteys</div>
      <h1 class="hero__title">Laita<br />viestiä</h1>
      <p class="hero__body">
        Juttuvinkit, yhteistyöt, palaute tai ihan vaan morjens — sähköposti
        tavoittaa parhaiten. Vastaan kun ehdin.
      </p>
      <a href={`mailto:${email}`} class="hero__email">{email} →</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .eyebrow {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e2701b;
    margin-bottom: 18px;
  }

  /* hero */
  .hero {
    position: relative;
    padding: 88px 46px 80px;
    background: #000;
    border-bottom: 1px solid rgba(237, 230, 210, 0.12);
    overflow: hidden;
  }
  .hero__img {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: auto;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 55%);
    mask-image: linear-gradient(to right, transparent, #000 55%);
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 120% at 80% 0%, rgba(226, 112, 27, 0.16), transparent 55%);
  }
  .hero__inner {
    position: relative;
    max-width: 620px;
  }
  .hero__title {
    font-weight: 900;
    font-size: 88px;
    line-height: 0.9;
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .hero__body {
    font-size: 18px;
    line-height: 1.7;
    max-width: 540px;
    margin: 0 0 34px;
    color: #cfc7ad;
    font-weight: 500;
  }
  .hero__email {
    display: inline-block;
    background: #911b1b;
    color: #ede6d2;
    text-decoration: none;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.01em;
    padding: 18px 34px;
    border-radius: 2px;
    transition: background 0.15s ease;
  }
  .hero__email:hover {
    background: #a51f1f;
  }

  /* responsive */
  @media (max-width: 900px) {
    .hero__title {
      font-size: 68px;
    }
    .hero__img {
      opacity: 0.5;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding: 56px 24px 48px;
    }
    .hero__title {
      font-size: 52px;
    }
    .hero__email {
      font-size: 17px;
      padding: 16px 24px;
    }
  }
</style>
