---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat("fi-FI", { day: "numeric", month: "long", year: "numeric" }).format(d);
---

<Layout title={`${post.data.title} — Kampiapina`} description={post.data.description}>
  <Nav active="blogi" />

  <article class="post">
    <div class="post__head">
      <a href="/blogi" class="post__back">← Blogi</a>
      {post.data.category && <div class="eyebrow">{post.data.category}</div>}
      <h1 class="post__title">{post.data.title}</h1>
      <div class="post__meta">
        <span>{fmtDate(post.data.pubDate)}</span>
        {
          post.data.tags.length > 0 && (
            <span class="post__tags">
              {post.data.tags.slice(0, 6).map((t) => <span class="tag">{t}</span>)}
            </span>
          )
        }
      </div>
    </div>

    {
      post.data.heroImage && (
        <div class="post__hero">
          <img src={post.data.heroImage} alt="" loading="lazy" />
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <div class="post__foot">
      <a href="/blogi" class="post__back">← Takaisin blogiin</a>
      {
        post.data.originalUrl && (
          <a href={post.data.originalUrl} class="post__orig">Alkuperäinen julkaisu →</a>
        )
      }
    </div>
  </article>

  <Footer />
</Layout>

<style>
  .eyebrow {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e2701b;
    margin-bottom: 14px;
  }

  .post__head {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 24px 30px;
  }
  .post__back {
    display: inline-block;
    color: #8f9270;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 26px;
  }
  .post__back:hover {
    color: #e2701b;
  }
  .post__title {
    font-weight: 900;
    font-size: 46px;
    line-height: 1.05;
    margin: 0 0 20px;
    letter-spacing: -0.01em;
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    color: #8f9270;
    font-size: 14px;
    font-weight: 600;
    font-family: "Barlow Condensed", sans-serif;
    letter-spacing: 0.04em;
  }
  .post__tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag {
    border: 1px solid rgba(237, 230, 210, 0.18);
    color: #a8a488;
    font-family: "Montserrat", sans-serif;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 2px;
  }

  .post__hero {
    max-width: 960px;
    margin: 10px auto 0;
    padding: 0 24px;
  }
  .post__hero img {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid rgba(237, 230, 210, 0.12);
  }

  /* prose */
  .prose {
    max-width: 760px;
    margin: 0 auto;
    padding: 34px 24px 20px;
    font-size: 17px;
    line-height: 1.75;
    color: #cfc7ad;
    font-weight: 500;
  }
  .prose :global(p) {
    margin: 0 0 22px;
  }
  .prose :global(h2) {
    font-family: "Montserrat", sans-serif;
    font-weight: 800;
    font-size: 28px;
    line-height: 1.2;
    color: #ede6d2;
    margin: 44px 0 16px;
    letter-spacing: -0.01em;
  }
  .prose :global(h3) {
    font-weight: 800;
    font-size: 21px;
    color: #ede6d2;
    margin: 34px 0 12px;
  }
  .prose :global(a) {
    color: #ede6d2;
    text-decoration: none;
    border-bottom: 1px solid #e2701b;
    transition: color 0.15s ease;
  }
  .prose :global(a:hover) {
    color: #e2701b;
  }
  .prose :global(strong) {
    color: #ede6d2;
    font-weight: 700;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 28px auto;
    border: 1px solid rgba(237, 230, 210, 0.12);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 22px;
    padding-left: 24px;
  }
  .prose :global(li) {
    margin: 0 0 8px;
  }
  .prose :global(li::marker) {
    color: #e2701b;
  }
  .prose :global(blockquote) {
    margin: 26px 0;
    padding: 6px 0 6px 24px;
    border-left: 3px solid #e2701b;
    color: #a8a488;
    font-style: italic;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid rgba(237, 230, 210, 0.14);
    margin: 40px 0;
  }
  .prose :global(iframe),
  .prose :global(video) {
    max-width: 100%;
    margin: 28px auto;
    display: block;
  }
  .prose :global(pre) {
    background: #191a10;
    border: 1px solid rgba(237, 230, 210, 0.12);
    padding: 18px 20px;
    overflow-x: auto;
    border-radius: 3px;
    font-size: 14px;
  }
  .prose :global(code) {
    font-family: ui-monospace, monospace;
    font-size: 0.9em;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid rgba(237, 230, 210, 0.14);
    padding: 10px 14px;
    text-align: left;
  }

  .post__foot {
    max-width: 760px;
    margin: 0 auto;
    padding: 24px 24px 64px;
    border-top: 1px solid rgba(237, 230, 210, 0.12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .post__orig {
    color: #8f9270;
    text-decoration: none;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .post__orig:hover {
    color: #e2701b;
  }

  @media (max-width: 600px) {
    .post__title {
      font-size: 34px;
    }
    .prose {
      font-size: 16px;
    }
  }
</style>
