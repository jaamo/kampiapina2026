---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const stats = [
  { value: "12k", label: "YouTube-tilaajaa", color: "#E2701B" },
  { value: "5000+", label: "Tyypillinen katsojamäärä", color: "#FBB405" },
  { value: "5700", label: "Instagram-tilaajaa", color: "#696C46" },
  { value: "1500+", label: "Tyypilliset näyttökerrat", color: "#EDE6D2" },
];

const proofPoints = [
  { title: "Aitoa, ei mainosta", desc: "Sisältö istuu kanavan henkeen, joten se ei tunnu mainokselta vaan suositukselta." },
  { title: "Sitoutunut yleisö", desc: "Pyöräilevä yhteisö, joka oikeasti kuuntelee, kyselee ja reagoi." },
  { title: "Pitkä elinkaari", desc: "Video jää nettiin ja kerää katsojia vielä kuukausien päästä." },
];

const steps = [
  "Otat yhteyttä.",
  "Kerron mitä yhteistyö maksaa ja mitä se voisi olla.",
  "Tapaaminen tai muuten sovitaan yksityiskohdista.",
  "Teen sisällöt — videot voi halutessaan tsekata etukäteen.",
  "Julkaisu.",
  "Toimitan tiedot yleensä n. kuukauden päästä: miten meni.",
];
---

<Layout title="Yhteistyöt — Kampiapina" description="Kampiapina tavoittaa aidon, sitoutuneen pyöräily-yleisön Suomessa. Tehdään diili joka istuu kanavan henkeen.">
  <Nav active="yhteistyot" />

  <!-- hero -->
  <div class="hero">
    <div class="hero__text">
      <div class="hero__glow"></div>
      <div class="hero__inner">
        <div class="eyebrow">Yhteistyöt &amp; media</div>
        <h1 class="hero__title">Tavoita tuhansia pyöräilijöitä</h1>
        <p class="hero__body">
          Kampiapina tavoittaa aidon, sitoutuneen pyöräily-yleisön Suomessa. Jos
          brändisi puhuttelee pyöräileviä ihmisiä, jutellaan — teen mielelläni
          yhteistyötä joka istuu kanavan henkeen (eli on rehellistä ja hauskaa).
        </p>
        <a href="mailto:jaakko@kampiapina.com" class="btn btn--primary">Ota yhteyttä →</a>
      </div>
    </div>
    <div class="hero__media">
      <span class="placeholder">[ KUVA ]</span>
    </div>
  </div>

  <!-- audience stats -->
  <div class="audience">
    <div class="audience__label">Yleisö pähkinänkuoressa</div>
    <div class="stat-grid">
      {
        stats.map((stat) => (
          <div class="stat-card">
            <div class="stat-card__num" style={`color:${stat.color};`}>{stat.value}</div>
            <div class="stat-card__label">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- social proof over advertising -->
  <div class="proof">
    <div class="proof__intro">
      <div class="eyebrow">Miksi Kampiapina</div>
      <h2 class="proof__title">Suositus voittaa mainoksen</h2>
      <p class="proof__body">
        Ihmiset ovat oppineet ohittamaan bannerit ja preroll-mainokset. Sen
        sijaan luotetaan tuttuun naamaan: kun tuote toimii aidosti osana
        pyöräilyarkea ja sanon sen omin sanoin, viesti menee perille. Sitoutunut
        yleisö kuuntelee, kyselee ja ostaa — koska suositus tulee ihmiseltä, ei
        mainostoimistolta.
      </p>
    </div>
    <div class="proof-grid">
      {
        proofPoints.map((p) => (
          <div class="proof-card">
            <h3 class="proof-card__title">{p.title}</h3>
            <p class="proof-card__desc">{p.desc}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- what I offer -->
  <div class="offers-section">
    <div class="offers__head">
      <h2 class="offers__title">Mitä tarjoan</h2>
      <span class="offers__aside">Räätälöidään aina yhdessä.</span>
    </div>
    <div class="offer-single">
      <ul class="offer-points">
        <li>Tehdään yhdessä mielenkiintoista sisältöä.</li>
        <li>Joko video, somesisällöt tai kummatkin.</li>
        <li>Suunnitellaan yhdessä sisältöjen luonne.</li>
      </ul>
      <div class="process">
        <div class="process__title">Näin se etenee</div>
        <ol class="process__steps">
          {steps.map((s) => <li>{s}</li>)}
        </ol>
      </div>
      <div class="offer-pay">
        Maksu laskulla · Apina Studio tmi, Y-tunnus 3196500-8
      </div>
    </div>
  </div>

  <!-- contact CTA -->
  <div class="cta">
    <div>
      <h2 class="cta__title">Jutellaan lisää</h2>
      <p class="cta__desc">
        Kerro lyhyesti brändistäsi ja ideastasi, niin palaan asiaan. Lähetän
        pyydettäessä tarkemman mediakortin ja hinnaston.
      </p>
    </div>
    <div class="cta__actions">
      <a href="mailto:jaakko@kampiapina.com" class="cta__primary">jaakko@kampiapina.com</a>
      <a href="https://www.instagram.com/kampiapina/" class="cta__ghost">DM @kampiapina</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .eyebrow {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e2701b;
    margin-bottom: 18px;
  }
  .placeholder {
    font-family: "Barlow Condensed", sans-serif;
    letter-spacing: 0.12em;
    color: rgba(237, 230, 210, 0.5);
    font-size: 13px;
    border: 1px dashed rgba(237, 230, 210, 0.35);
    padding: 9px 15px;
  }

  /* hero */
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
    border-bottom: 1px solid rgba(237, 230, 210, 0.12);
    background: #191a10;
  }
  .hero__text {
    position: relative;
    padding: 72px 46px 60px;
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(110% 120% at 85% 10%, rgba(226, 112, 27, 0.16), transparent 55%);
  }
  .hero__inner {
    position: relative;
    max-width: 560px;
  }
  .hero__title {
    font-weight: 900;
    font-size: 66px;
    line-height: 0.95;
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .hero__body {
    font-size: 18px;
    line-height: 1.7;
    max-width: 560px;
    margin: 0 0 32px;
    color: #cfc7ad;
    font-weight: 500;
  }
  .hero__media {
    position: relative;
    min-height: 420px;
    background: #20220f;
    background-image: repeating-linear-gradient(115deg, rgba(105, 108, 70, 0.35) 0 2px, transparent 2px 40px);
    display: flex;
    align-items: center;
    justify-content: center;
    border-left: 1px solid rgba(237, 230, 210, 0.1);
  }

  .btn {
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 16px 30px;
    border-radius: 2px;
    display: inline-block;
  }
  .btn--primary {
    background: #911b1b;
    color: #ede6d2;
  }
  .btn--primary:hover {
    background: #a51f1f;
  }

  /* audience */
  .audience {
    padding: 60px 46px 20px;
  }
  .audience__label {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8f9270;
    margin-bottom: 26px;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 44px;
  }
  .stat-card {
    border: 1px solid rgba(237, 230, 210, 0.14);
    background: #191a10;
    padding: 30px 26px;
  }
  .stat-card__num {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 60px;
    line-height: 0.95;
  }
  .stat-card__label {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8f9270;
    margin-top: 8px;
  }

  /* social proof */
  .proof {
    padding: 8px 46px 60px;
  }
  .proof__intro {
    max-width: 720px;
    margin-bottom: 34px;
  }
  .proof__title {
    font-weight: 900;
    font-size: 44px;
    margin: 0 0 18px;
    text-transform: uppercase;
    line-height: 1;
  }
  .proof__body {
    font-size: 18px;
    line-height: 1.7;
    margin: 0;
    color: #cfc7ad;
    font-weight: 500;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .proof-card {
    border: 1px solid rgba(237, 230, 210, 0.14);
    border-left: 3px solid #e2701b;
    background: #191a10;
    padding: 26px 26px 28px;
  }
  .proof-card__title {
    font-weight: 800;
    font-size: 19px;
    margin: 0 0 10px;
  }
  .proof-card__desc {
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
    color: #a8a488;
    font-weight: 500;
  }

  /* offers */
  .offers-section {
    padding: 8px 46px 60px;
  }
  .offers__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 32px;
    gap: 24px;
  }
  .offers__title {
    font-weight: 900;
    font-size: 44px;
    margin: 0;
    text-transform: uppercase;
  }
  .offers__aside {
    color: #8f9270;
    font-weight: 600;
    font-size: 14px;
  }
  .offer-single {
    border: 1px solid rgba(237, 230, 210, 0.14);
    background: #191a10;
    padding: 36px 38px;
    max-width: 780px;
  }
  .offer-points {
    list-style: none;
    margin: 0 0 30px;
    padding: 0;
  }
  .offer-points li {
    position: relative;
    padding-left: 26px;
    font-size: 17px;
    line-height: 1.55;
    color: #ede6d2;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .offer-points li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: #e2701b;
    font-weight: 800;
  }
  .process {
    border-top: 1px solid rgba(237, 230, 210, 0.1);
    padding-top: 26px;
  }
  .process__title {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #e2701b;
    margin-bottom: 18px;
  }
  .process__steps {
    margin: 0;
    padding-left: 0;
    list-style: none;
    counter-reset: step;
  }
  .process__steps li {
    counter-increment: step;
    position: relative;
    padding-left: 42px;
    min-height: 28px;
    display: flex;
    align-items: center;
    font-size: 15px;
    line-height: 1.5;
    color: #cfc7ad;
    font-weight: 500;
    margin-bottom: 14px;
  }
  .process__steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #20220f;
    border: 1px solid rgba(226, 112, 27, 0.5);
    color: #e2701b;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .offer-pay {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid rgba(237, 230, 210, 0.1);
    font-size: 14px;
    letter-spacing: 0.04em;
    color: #8f9270;
    font-weight: 600;
  }

  /* cta */
  .cta {
    margin: 0 46px 72px;
    background: linear-gradient(100deg, #911b1b, #6d1414);
    border-radius: 4px;
    padding: 52px 46px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 34px;
    flex-wrap: wrap;
  }
  .cta__title {
    font-weight: 900;
    font-size: 40px;
    margin: 0 0 10px;
    text-transform: uppercase;
  }
  .cta__desc {
    margin: 0;
    color: #f0d5d5;
    font-size: 16px;
    max-width: 520px;
    font-weight: 500;
  }
  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cta__primary {
    background: #ede6d2;
    color: #911b1b;
    text-decoration: none;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 16px 30px;
    border-radius: 2px;
    text-align: center;
  }
  .cta__ghost {
    color: #ede6d2;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    border: 1px solid rgba(237, 230, 210, 0.4);
    padding: 14px 30px;
    border-radius: 2px;
  }
  .cta__ghost:hover {
    border-color: rgba(237, 230, 210, 0.8);
  }

  /* responsive */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__media {
      min-height: 280px;
      border-left: none;
      border-top: 1px solid rgba(237, 230, 210, 0.1);
    }
    .hero__title {
      font-size: 54px;
    }
    .stat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .hero__text {
      padding: 48px 24px;
    }
    .hero__title {
      font-size: 44px;
    }
    .audience,
    .proof,
    .offers-section {
      padding-left: 24px;
      padding-right: 24px;
    }
    .stat-grid {
      grid-template-columns: 1fr;
    }
    .proof__title {
      font-size: 34px;
    }
    .offer-single {
      padding: 28px 22px;
    }
    .offers__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .cta {
      margin: 0 24px 48px;
      padding: 40px 28px;
    }
    .cta__actions {
      width: 100%;
    }
  }
</style>
