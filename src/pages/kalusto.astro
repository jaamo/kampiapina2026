---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const YT = "https://www.youtube.com/channel/UC2Prp3t7Ol-a041FXTyCzNQ";

const bikes = [
  {
    name: "Surly Straggler",
    role: "Arki",
    desc: "Uskollinen arkijuhta, joka on kulkenut matkan trendikkäästä sinkulasta hybridiksi.",
    img: "/bikes/surly-straggler.jpg",
  },
  {
    name: "Pelago Stavanger",
    role: "Gravel",
    desc: "Gravel-pyörä. Tälle tulee arkipyörän jälkeen eniten kilsoja. Voi mennä melkeinpä mihin vain.",
    img: "/bikes/pelago-stavanger.jpg",
  },
  {
    name: "Pelago Sibbo",
    role: "Brevet",
    desc: "Sibbo oli pitkään unelmieni pyörä ja tuli talliin 2018. Nykyisellään tämä pyörä on säädetty brevettikäyttöön.",
    img: "/bikes/pelago-sibbo.jpg",
  },
  {
    name: "Pelago San Sebastian",
    role: "Fiksi",
    desc: "Tallissa pitää olla yksi pyörä vain siitä syystä, että sillä ajamisesta tulee hyvä fiilis. Fiksi.",
    img: "/bikes/pelago-san-sebastian.jpg",
  },
  {
    name: "Van Nicholas Skeiron",
    role: "Maantie",
    desc: "Mulle liian hyvä maantietykki. Titaania. Hiilikuitua. Sähkövaihteet. Huhhuh.",
    img: "/bikes/van-nicholas-skeiron.jpg",
  },
  {
    name: "Trek Roscoe 7",
    role: "Maasto",
    desc: "Monikäyttöinen maasturi. Aika vähän tulee kilsoja. Mutta sen verran, että pysyy tallissa.",
    img: "/bikes/trek-roscoe.jpg",
  },
  {
    name: "Koxx Unicycle",
    role: "Yksipyöräinen",
    desc: "Keski-iän lievitystä.",
    img: null,
  },
];
---

<Layout title="Kalusto — Kampiapina" description="Kampiavun talli: kahdeksan pyörää jokaiseen keliin ja mielentilaan – maantiestä maastoon ja fiksistä yksipyöräiseen.">
  <Nav active="kalusto" />

  <!-- hero -->
  <div class="hero">
    <div class="hero__text">
      <div class="eyebrow">Kalusto</div>
      <h1 class="hero__title">Miksi näin<br />monta?</h1>
      <p class="hero__body">
        En halua omistaa yhtään ylimääräistä pyörää. Silti omistan aika monta
        pyörää. Ihminen on hyvä keksimään itselleen syitä, miksi juuri nämä
        pyörät on ehdottoman välttämätöntä omistaa.
      </p>
      <p class="hero__body">
        Kaikille pyörilleni löytyy
        joku tarkoitus. Tavoitteeni on, että jokaisella pyörällä ajetaan
        keskimääräistä espoolaista enemmän. Eli parisataa kilometriä.
      </p>
      <p class="hero__body">
        Arvostan pyörissä kestävyyttä ja helppoa huollettavuutta. Sen vuoksi
        varastoon on kertynyt terästä.
      </p>
    </div>
    <div class="hero__media">
      <img src="/kalusto-hero.jpg" alt="Maantieajoa kesäillassa" class="hero__img" />
      <div class="hero__media-glow"></div>
    </div>
  </div>

  <!-- kalusto -->
  <div class="section">
    <div class="section__head">
      <div>
        <div class="eyebrow">Talli</div>
        <h2 class="section__title">Kalusto</h2>
      </div>
      <span class="section__aside">Jokaiseen keliin ja mielentilaan oma rautansa.</span>
    </div>
    <div class="bike-grid">
      {
        bikes.map((bike) => (
          <div class="bike-card">
            <div class="bike-card__img">
              {bike.img ? (
                <img src={bike.img} alt={bike.name} class="bike-card__photo" loading="lazy" />
              ) : (
                <span class="bike-card__ph">[ kuva ]</span>
              )}
            </div>
            <div class="bike-card__body">
              <div class="bike-card__role">{bike.role}</div>
              <div class="bike-card__name">{bike.name}</div>
              <p class="bike-card__desc">{bike.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- pyoratori note -->
  <div class="pyoratori">
    <div>
      <div class="pyoratori__title">Vaihtuuko kalusto?</div>
      <p class="pyoratori__desc">
        Tsekkaa käytetyt polkupyörät osoitteessa pyoratori.com — sieltä löytyy
        silloin tällöin myös allekirjoittaneen vanhaa rautaa.
      </p>
    </div>
    <a href="https://pyoratori.com/" class="pyoratori__cta">pyoratori.com →</a>
  </div>

  <Footer />
</Layout>

<style>
  .eyebrow {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e2701b;
    margin-bottom: 18px;
  }
  /* hero */
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    border-bottom: 1px solid rgba(237, 230, 210, 0.12);
  }
  .hero__text {
    padding: 72px 46px 64px;
    background: #191a10;
  }
  .hero__title {
    font-weight: 900;
    font-size: 88px;
    line-height: 0.9;
    margin: 0 0 26px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .hero__body {
    font-size: 18px;
    line-height: 1.7;
    max-width: 520px;
    margin: 0 0 20px;
    color: #cfc7ad;
    font-weight: 500;
  }
  .hero__body:last-of-type {
    margin-bottom: 32px;
  }
  .hero__media {
    position: relative;
    min-height: 520px;
    background: #20220f;
    overflow: hidden;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  .hero__media-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 100% at 60% 20%, rgba(226, 112, 27, 0.14), transparent 55%);
  }

  .btn {
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 16px 30px;
    border-radius: 2px;
    display: inline-block;
  }
  .btn--primary {
    background: #911b1b;
    color: #ede6d2;
  }
  .btn--primary:hover {
    background: #a51f1f;
  }

  /* section */
  .section {
    padding: 64px 46px;
  }
  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 36px;
    gap: 24px;
  }
  .section__title {
    font-weight: 900;
    font-size: 46px;
    margin: 0;
    text-transform: uppercase;
  }
  .section__aside {
    color: #8f9270;
    font-weight: 600;
    font-size: 14px;
    max-width: 320px;
    text-align: right;
  }

  .bike-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .bike-card {
    border: 1px solid rgba(237, 230, 210, 0.14);
    background: #191a10;
    transition: border-color 0.15s ease;
  }
  .bike-card:hover {
    border-color: rgba(226, 112, 27, 0.6);
  }
  .bike-card__img {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #20220f;
    background-image: repeating-linear-gradient(115deg, rgba(105, 108, 70, 0.4) 0 2px, transparent 2px 30px);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(237, 230, 210, 0.12);
    overflow: hidden;
  }
  .bike-card__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bike-card__ph {
    font-family: "Barlow Condensed", sans-serif;
    letter-spacing: 0.1em;
    color: rgba(237, 230, 210, 0.45);
    font-size: 12px;
  }
  .bike-card__body {
    padding: 16px 16px 18px;
  }
  .bike-card__role {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e2701b;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .bike-card__name {
    font-weight: 800;
    font-size: 16px;
    margin-bottom: 8px;
  }
  .bike-card__desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: #a8a488;
    font-weight: 500;
  }

  /* pyoratori */
  .pyoratori {
    margin: 0 46px 64px;
    background: linear-gradient(100deg, #20220f, #191a10);
    border: 1px solid rgba(237, 230, 210, 0.14);
    border-radius: 4px;
    padding: 36px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
  }
  .pyoratori__title {
    font-weight: 800;
    font-size: 22px;
    margin-bottom: 6px;
  }
  .pyoratori__desc {
    margin: 0;
    color: #a8a488;
    font-size: 15px;
    max-width: 520px;
    font-weight: 500;
  }
  .pyoratori__cta {
    background: #e2701b;
    color: #15160e;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 15px 28px;
    border-radius: 2px;
    white-space: nowrap;
  }
  .pyoratori__cta:hover {
    background: #f0842e;
  }

  /* responsive */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__media {
      min-height: 320px;
    }
    .hero__title {
      font-size: 68px;
    }
    .bike-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .hero__text {
      padding: 48px 24px;
    }
    .hero__title {
      font-size: 52px;
    }
    .section {
      padding: 48px 24px;
    }
    .section__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .section__aside {
      text-align: left;
    }
    .bike-grid {
      grid-template-columns: 1fr;
    }
    .pyoratori {
      margin: 0 24px 48px;
      padding: 28px 24px;
    }
  }
</style>
