---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const shopUrl = "https://kampiapina.myspreadshop.fi/";
---

<Layout
  title="Kauppa — Kampiapina"
  description="Kampiapinan kauppa: t-paitoja, huppareita ja muuta tavaraa pyöräilijälle. Toimitus suoraan Spreadshopista."
>
  <Nav active="kauppa" />

  <!-- hero -->
  <div class="hero">
    <div class="hero__glow"></div>
    <div class="hero__inner">
      <div class="eyebrow">Kauppa</div>
      <h1 class="hero__title">Morjesta<br />päälle</h1>
      <p class="hero__body">
        Kampiapinan omat paidat, hupparit ja muut kamppeet. Tuotteet painetaan
        ja toimitetaan Spreadshopin kautta — valitse malli, väri ja koko, niin
        posti tuo.
      </p>
      <a href={shopUrl} class="hero__link">Avaa kauppa omassa ikkunassa →</a>
    </div>
  </div>

  <!-- shop -->
  <div class="shop">
    <div id="myShop" class="shop__mount">
      <div id="shopLoading" class="shop__loading">
        Ladataan kauppaa…
        <noscript>
          Kauppa vaatii JavaScriptin. <a href={shopUrl}>Siirry kauppaan tästä.</a>
        </noscript>
      </div>
    </div>

    <div id="shopFallback" class="shop__fallback" hidden>
      <div class="shop__fallback-eyebrow">Kauppa aukeaa omassa osoitteessaan</div>
      <h2 class="shop__fallback-title">Kampiapinan kauppa</h2>
      <p class="shop__fallback-body">
        Kauppaa ei juuri nyt saada upotettua tähän sivuun. Ei hätää — koko
        valikoima löytyy Spreadshopista.
      </p>
      <a href={shopUrl} class="shop__fallback-cta">Siirry kauppaan →</a>
    </div>
  </div>

  <Footer />
</Layout>

<script is:inline>
  var spread_shop_config = {
    shopName: "kampiapina",
    locale: "fi_FI",
    prefix: "https://shop.myspreadshop.fi",
    baseId: "myShop",
  };

  // Kaupan oma aliverkkotunnus (kampiapina.myspreadshop.fi) ei tarjoile
  // shopData-rajapintaa lainkaan: se vastaa 404 eikä palauta CORS-otsakkeita.
  // Vain yleinen shop.myspreadshop.fi tekee sen (Access-Control-Allow-Origin: *).
  // Shopclient lukee kuitenkin core-vastauksesta shopBaseUrl-kentän, joka osoittaa
  // aliverkkotunnukseen, ja käyttää sitä seuraaviin hakuihin. Ohjataan ne takaisin.
  (function () {
    var from = "https://kampiapina.myspreadshop.fi/kampiapina/shopData/";
    var to = "https://shop.myspreadshop.fi/kampiapina/shopData/";
    var original = window.fetch;
    if (!original) return;

    window.fetch = function (input, init) {
      if (typeof input === "string" && input.indexOf(from) === 0) {
        input = to + input.slice(from.length);
      } else if (input && input.url && input.url.indexOf(from) === 0) {
        input = new Request(to + input.url.slice(from.length), input);
      }
      return original.call(this, input, init);
    };
  })();
</script>
<script
  is:inline
  type="text/javascript"
  src="https://shop.myspreadshop.fi/shopfiles/shopclient/shopclient.nocache.js"></script>
       
<script is:inline>
  // Jos shopclient ei saa piirrettyä kauppaa, näytetään linkki kauppaan.
  (function () {
    var mount = document.getElementById("myShop");
    var loading = document.getElementById("shopLoading");
    var fallback = document.getElementById("shopFallback");
    if (!mount || !fallback) return;

    var rendered = function () {
      for (var i = 0; i < mount.children.length; i++) {
        if (mount.children[i] !== loading) return true;
      }
      return false;
    };

    var check = function (attempt) {
      if (rendered()) {
        if (loading) loading.hidden = true;
        return;
      }
      if (attempt >= 8) {
        if (loading) loading.hidden = true;
        mount.hidden = true;
        fallback.hidden = false;
        return;
      }
      setTimeout(function () {
        check(attempt + 1);
      }, 750);
    };

    check(0);
  })();
</script>

<style>
  .eyebrow {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e2701b;
    margin-bottom: 18px;
  }

  /* hero */
  .hero {
    position: relative;
    padding: 88px 46px 80px;
    background: #000;
    border-bottom: 1px solid rgba(237, 230, 210, 0.12);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      90% 120% at 80% 0%,
      rgba(226, 112, 27, 0.16),
      transparent 55%
    );
  }
  .hero__inner {
    position: relative;
    max-width: 620px;
  }
  .hero__title {
    font-weight: 900;
    font-size: 88px;
    line-height: 0.9;
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .hero__body {
    font-size: 18px;
    line-height: 1.7;
    max-width: 540px;
    margin: 0 0 34px;
    color: #cfc7ad;
    font-weight: 500;
  }
  .hero__link {
    display: inline-block;
    background: #911b1b;
    color: #ede6d2;
    text-decoration: none;
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.02em;
    padding: 16px 30px;
    border-radius: 2px;
    transition: background 0.15s ease;
  }
  .hero__link:hover {
    background: #a51f1f;
  }

  /* shop */
  .shop {
    background: #ede6d2;
    color: #15160e;
    padding: 40px 46px 56px;
    min-height: 400px;
  }
  .shop__mount {
    max-width: 1240px;
    margin: 0 auto;
  }
  .shop__loading {
    padding: 80px 0;
    text-align: center;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #6f6a55;
  }
  .shop__fallback {
    max-width: 640px;
    margin: 0 auto;
    padding: 70px 0 60px;
    text-align: center;
  }
  .shop__fallback-eyebrow {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #b3541a;
    margin-bottom: 14px;
  }
  .shop__fallback-title {
    font-weight: 900;
    font-size: 44px;
    line-height: 1;
    margin: 0 0 18px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .shop__fallback-body {
    font-size: 17px;
    line-height: 1.7;
    color: #4a4738;
    font-weight: 500;
    margin: 0 0 30px;
  }
  .shop__fallback-cta {
    display: inline-block;
    background: #911b1b;
    color: #ede6d2;
    text-decoration: none;
    font-weight: 800;
    font-size: 17px;
    padding: 17px 32px;
    border-radius: 2px;
    transition: background 0.15s ease;
  }
  .shop__fallback-cta:hover {
    background: #a51f1f;
  }

  /* responsive */
  @media (max-width: 900px) {
    .hero__title {
      font-size: 68px;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding: 56px 24px 48px;
    }
    .hero__title {
      font-size: 52px;
    }
    .hero__link {
      font-size: 15px;
      padding: 15px 24px;
    }
    .shop {
      padding: 28px 18px 44px;
    }
    .shop__fallback-title {
      font-size: 34px;
    }
  }
</style>
