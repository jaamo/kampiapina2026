---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const email = "jaakko@alajoki.fi";

const formatStats = [
  { value: "8", label: "Videota", color: "#E2701B" },
  { value: "5 000", label: "Tyypillisesti katsojaa", color: "#FBB405" },
  { value: "11.–19.9.", label: "Syyskuu 2026", color: "#EDE6D2" },
];

---

<Layout
  title="Ruska-seuranta 2026 — Kampiapina"
  description="Kampiapina seuraa Ruska-ultrapyöräilytapahtumaa päivittäisillä videoilla syyskuussa 2026. Osta videoon 30 sekuntia mainosaikaa: 200 € + alv."
>
  <Nav active="yhteistyot" />

  <!-- hero -->
  <div class="hero">
    <img
      src="/ruska-norja.jpg"
      alt=""
      class="hero__bg"
    />
    <div class="hero__shade"></div>
    <div class="hero__inner">
      <div class="hero__text">
        <div class="eyebrow">Ruska-seuranta · Syyskuu 2026</div>
        <h1 class="hero__title">Brändisi mukaan Ruska&#8209;seurantaan</h1>
        <p class="hero__body">
          Suomen seuratuin pyöräilytapahtuma Ruska ajetaan taas syyskuussa. En ole itse lähdössä tällä kertaa mukaan, mutta aion tehdä pävittäin
          seurantavideon YouTube-kanavalleni.</p>
        <p class="hero__body">
          Tarjoankin nyt mahdollisuutta ostaa näkyvyyttä näillä videoilla. Jos haluat tavoittaa tuhansia pyöräilystä kiinnostuneita 
          ihmisiä, ollaan yhteyksissä!
        </p>
        <div class="hero__promo">
          <div class="hero__promo-item">
            <div class="hero__promo-num">200 €</div>
            <div class="hero__promo-label">+ alv / video</div>
          </div>
          <div class="hero__promo-item">
            <div class="hero__promo-num">30 s</div>
            <div class="hero__promo-label">mainosaikaa</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- what is Ruska -->
  <div class="ruska">
    <div class="ruska__text">
      <div class="ruska__label">Mikä Ruska?</div>
      <h2 class="ruska__title">Suomen seuratuin pyöräilytapahtuma</h2>
      <p class="ruska__body">
        Ruska on unsupported-ultrapyöräilytapahtuma, jossa ajetaan koko Suomen
        halki: Huittisista Nuorgamiin, napapiirin yli, keskellä kauneinta
        ruska-aikaa. Matkaa kertyy noin 2 000 kilometriä. Lähtö on
        auringonlaskun aikaan perjantaina 11.9.2026 ja maalissa pitää olla
        viimeistään lauantaina 19.9. keskiyöllä. Ulkopuolinen apu on kielletty —
        jokainen ajaa omillaan, yksin tai parina. 
      </p>
      <p class="ruska__body">
        Ruska on eittämättä yksi Suomen seuratuimpia pyöräilytapahtumia.
        Mikään muu tapahtuma ei valtaa sosiaalisen median keskusteluja samalla tavalla ja tilastollisesti kaikki Ruska-aiheinen sisältö kiinnostaa yleisöä. 
      </p>
    </div>
    <div class="ruska__media">
      <div class="ruska__photo">
        <img
          src="/ruska-sarmi.jpg"
          alt="Pyöräilyvarusteilla lastattu polkupyörä nojaa mäntyyn Sarmi-kyltin alla"
          class="ruska__img"
        />
        <span class="ruska__caption ruska__caption--tl">Pyöräni Sarmi-tunturin juurella</span>
      </div>
      <div class="ruska__photo">
        <img
          src="/ruska-kalmakaltio.jpg"
          alt="Bikepacking-pyörä nojaa puisen sillan kaiteeseen ruskamaisemassa"
          class="ruska__img"
        />
        <span class="ruska__caption ruska__caption--br">Kalmakaltion kontrolli</span>
      </div>
    </div>
  </div>

  <!-- video format -->
  <div class="format">
    <div class="format__glow"></div>
    <div class="format__inner">
      <div class="format__cols">
        <div>
          <div class="eyebrow">Seurantavideot</div>
          <h2 class="format__title">Tavoita pyöräilevä yleisö</h2>
          <p class="format__tagline">
            Julkaisen jokaisena tapahtumapäivänä 15–20 minuutin analyysivideon Kampiapinan
            YouTube-kanavalle. Videoissa seurataan päivän etenemistä ja kohokohtia,
            kuullaan terveisiä osallistujilta, analysoidaan reittiä ja kalustoa
            sekä jaetaan kokemuksia tapahtumasta. Nostan jakson sponsorin esille luontevasti keskellä sisältöä. Sovitaan yhdessä, mitä asioita nostan esille!
          </p>
        </div>
        <img src="/ruska-studio.jpg" alt="Kampiapina esittelee seurantatilannetta studiossa" class="format__thumb" />
        <div class="format__bubble">
          "Ruskan ajaminen edellyttää, että varusteet on kunnossa. Ja siitä
          päästäänkin sopivasti meidän päivän sponsoriin! Maukan Pyörästä löytyy kattava valikoima bikepacking-laukkuja jokaiseen lähtöön.
          Bikepacking-laukut ovatkin sopivasti tarjouksessa nyt koko Ruskan ajan..."
        </div>
      </div>
      <div class="stat-grid">
        {
          formatStats.map((stat) => (
            <div class="stat-card">
              <div class="stat-card__num" style={`color:${stat.color};`}>{stat.value}</div>
              <div class="stat-card__label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- contact CTA -->
  <div class="cta">
    <div>
      <h2 class="cta__title">Ota yhteyttä, niin kerron lisää</h2>
      <p class="cta__desc">
        Yhden videon sponsorointi maksaa 200€ (alv 0%) ja sillä saa 30 sekuntia näkyvyyttä, joka tavoittaa tyypillisesti 5000 pyöräilijää. 
        Ota yhteyttä, niin kerron lisää ja voidaan sopia yksityiskohdista.
      </p>
    </div>
    <div class="cta__actions">
      <a href={`mailto:${email}`} class="cta__primary">{email}</a>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .eyebrow {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e2701b;
    margin-bottom: 18px;
  }

  /* hero */
  .hero {
    position: relative;
    padding: 88px 46px 80px;
    background: #191a10;
    border-bottom: 1px solid rgba(237, 230, 210, 0.12);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      95deg,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.62) 48%,
      rgba(0, 0, 0, 0.15) 100%
    );
  }
  .hero__inner {
    position: relative;
    max-width: 640px;
  }
  .hero__title {
    font-weight: 900;
    font-size: 74px;
    line-height: 0.92;
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .hero__body {
    font-size: 18px;
    line-height: 1.7;
    max-width: 560px;
    margin: 0 0 16px;
    color: #cfc7ad;
    font-weight: 500;
  }
  .hero__body:last-of-type {
    margin-bottom: 34px;
  }
  .hero__promo {
    display: inline-flex;
    align-items: stretch;
    gap: 34px;
    border: 1px solid rgba(226, 112, 27, 0.5);
    background: rgba(21, 22, 14, 0.75);
    padding: 22px 30px;
  }
  .hero__promo-item + .hero__promo-item {
    border-left: 1px solid rgba(237, 230, 210, 0.14);
    padding-left: 34px;
  }
  .hero__promo-num {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 52px;
    line-height: 0.9;
    color: #e2701b;
  }
  .hero__promo-label {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #cfc7ad;
    margin-top: 8px;
  }

  /* ruska intro */
  .ruska {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 56px;
    align-items: center;
    padding: 64px 46px;
  }
  .ruska__media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .ruska__label {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8f9270;
    margin-bottom: 26px;
  }
  .ruska__photo {
    position: relative;
  }
  .ruska__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    border: 1px solid rgba(237, 230, 210, 0.14);
  }
  .ruska__caption {
    position: absolute;
    background: #000;
    color: #fff;
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 14px;
    white-space: nowrap;
  }
  .ruska__caption--tl {
    top: 16px;
    left: 16px;
    transform: rotate(-3deg);
  }
  .ruska__caption--br {
    bottom: 16px;
    right: 16px;
    transform: rotate(2deg);
  }
  .ruska__title {
    font-weight: 900;
    font-size: 44px;
    line-height: 1;
    margin: 0 0 20px;
    text-transform: uppercase;
  }
  .ruska__body {
    margin: 0 0 16px;
    font-size: 17px;
    line-height: 1.7;
    color: #cfc7ad;
    font-weight: 500;
  }
  .ruska__body:last-child {
    margin-bottom: 0;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 16px;
  }
  .stat-card {
    border: 1px solid rgba(237, 230, 210, 0.14);
    background: #15160e;
    padding: 30px 26px;
  }
  .stat-card__num {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 48px;
    line-height: 0.95;
    white-space: nowrap;
  }
  .stat-card__label {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8f9270;
    margin-top: 8px;
  }

  /* video format */
  .format {
    position: relative;
    overflow: hidden;
    background: linear-gradient(100deg, #20220f, #191a10);
    border-top: 1px solid rgba(237, 230, 210, 0.12);
    border-bottom: 1px solid rgba(237, 230, 210, 0.12);
    padding: 76px 46px;
  }
  .format__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(80% 130% at 50% 0%, rgba(226, 112, 27, 0.14), transparent 60%);
  }
  .format__inner {
    position: relative;
  }
  .format__title {
    font-weight: 900;
    font-size: 50px;
    margin: 0 0 16px;
    text-transform: uppercase;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .format__cols {
    display: grid;
    grid-template-columns: 1.2fr 1fr 0.9fr;
    align-items: center;
    gap: 48px;
    margin-bottom: 44px;
  }
  .format__bubble {
    position: relative;
    background: #ede6d2;
    color: #15160e;
    border-radius: 10px;
    padding: 24px 26px;
    font-size: 15px;
    line-height: 1.65;
    font-weight: 600;
  }
  .format__bubble::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 50%;
    transform: translateY(-50%);
    border: 14px solid transparent;
    border-left: 0;
    border-right-color: #ede6d2;
  }
  .format__tagline {
    font-size: 18px;
    line-height: 1.6;
    color: #cfc7ad;
    font-weight: 500;
    max-width: 640px;
    margin: 0;
  }
  .format__thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-radius: 6px;
    border: 1px solid rgba(237, 230, 210, 0.2);
    transform: rotate(3deg);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
  }
  /* cta */
  .cta {
    margin: 64px 46px 72px;
    background: linear-gradient(100deg, #911b1b, #6d1414);
    border-radius: 4px;
    padding: 52px 46px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 34px;
    flex-wrap: wrap;
  }
  .cta__title {
    font-weight: 900;
    font-size: 40px;
    margin: 0 0 10px;
    text-transform: uppercase;
  }
  .cta__desc {
    margin: 0;
    color: #f0d5d5;
    font-size: 16px;
    max-width: 520px;
    font-weight: 500;
  }
  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cta__primary {
    background: #ede6d2;
    color: #911b1b;
    text-decoration: none;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 16px 30px;
    border-radius: 2px;
    text-align: center;
  }
  .cta__ghost {
    color: #ede6d2;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    border: 1px solid rgba(237, 230, 210, 0.4);
    padding: 14px 30px;
    border-radius: 2px;
  }
  .cta__ghost:hover {
    border-color: rgba(237, 230, 210, 0.8);
  }

  /* responsive */
  @media (max-width: 900px) {
    .hero__title {
      font-size: 56px;
    }
    .ruska {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .format__title {
      font-size: 40px;
    }
    .format__cols {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .format__thumb {
      max-width: 420px;
      transform: rotate(2deg);
    }
    .format__bubble {
      max-width: 460px;
    }
    .format__bubble::before {
      left: 48px;
      top: -13px;
      transform: none;
      border: 13px solid transparent;
      border-top: 0;
      border-bottom-color: #ede6d2;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding: 56px 24px 48px;
    }
    .hero__title {
      font-size: 44px;
    }
    .ruska {
      padding: 48px 24px;
    }
    .format {
      padding-left: 24px;
      padding-right: 24px;
    }
    .ruska__title {
      font-size: 34px;
    }
    .stat-grid {
      grid-template-columns: 1fr;
    }
    .format__title {
      font-size: 32px;
    }
    .cta {
      margin: 48px 24px;
      padding: 40px 28px;
    }
    .cta__actions {
      width: 100%;
    }
  }
</style>
