---
/**
 * Kierroksen ehdotuslista peukkuineen. Toimii ilman JavaScriptiä
 * (lomakepostaus + uudelleenohjaus); JS vain tekee siitä nopeamman.
 */
interface Suggestion {
  id: number;
  body: string;
  author: string;
  votes: number;
  voted: boolean | null;
}

interface Props {
  suggestions: Suggestion[];
  canVote: boolean;
  emptyText?: string;
}

const {
  suggestions,
  canVote,
  emptyText = "Ei vielä julkaistuja ehdotuksia. Ole ensimmäinen!",
} = Astro.props;

const leader = suggestions.length > 1 && suggestions[0].votes > 0 ? suggestions[0].id : null;
---

{
  suggestions.length === 0 ? (
    <p class="empty">{emptyText}</p>
  ) : (
    <ol class="list" data-vote-list>
      {suggestions.map((s, i) => (
        <li class:list={["item", { "item--lead": s.id === leader }]}>
          <form
            method="POST"
            action="/api/ruska/vote"
            class="vote"
            data-vote-form
            data-suggestion={s.id}
          >
            <input type="hidden" name="suggestion" value={s.id} />
            <button
              type="submit"
              class:list={["thumb", { "thumb--on": s.voted }]}
              disabled={!canVote}
              aria-pressed={s.voted ? "true" : "false"}
              aria-label={s.voted ? "Peru peukku" : "Anna peukku"}
              data-thumb
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" class="thumb__icon">
                <path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3m0 11V11m0 11h9.3a2 2 0 0 0 2-1.7l1.4-8A2 2 0 0 0 19.7 9H14V5a3 3 0 0 0-3-3l-4 9" />
              </svg>
              <span class="thumb__count" data-count>{s.votes}</span>
            </button>
          </form>
          <div class="body">
            <span class="rank">{String(i + 1).padStart(2, "0")}</span>
            <p class="text">{s.body}</p>
            {s.author && <div class="author">— {s.author}</div>}
          </div>
        </li>
      ))}
    </ol>
  )
}

<script>
  // Peukku päivittyy heti; ilman JS:ää sama lomake postaa normaalisti.
  document.querySelectorAll("form[data-vote-form]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      const button = form.querySelector("[data-thumb]");
      if (!(button instanceof HTMLButtonElement) || button.disabled) return;
      event.preventDefault();
      button.disabled = true;

      try {
        const response = await fetch(form.getAttribute("action"), {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ suggestion: form.dataset.suggestion }),
        });
        const result = await response.json();
        if (!result.ok) throw new Error(result.error ?? "Äänestys ei onnistunut.");

        const count = form.querySelector("[data-count]");
        if (count) count.textContent = String(result.votes);
        button.classList.toggle("thumb--on", result.voted);
        button.setAttribute("aria-pressed", result.voted ? "true" : "false");
        button.setAttribute("aria-label", result.voted ? "Peru peukku" : "Anna peukku");
      } catch (error) {
        // Jos jokin menee pieleen, annetaan selaimen hoitaa homma perinteisesti.
        form.submit();
        return;
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .empty {
    margin: 0;
    padding: 30px 26px;
    border: 1px dashed rgba(237, 230, 210, 0.2);
    color: #8f9270;
    font-size: 15px;
    font-weight: 500;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .item {
    display: flex;
    align-items: stretch;
    gap: 18px;
    background: #191a10;
    border: 1px solid rgba(237, 230, 210, 0.12);
    padding: 16px 20px 16px 16px;
  }
  .item--lead {
    border-color: rgba(226, 112, 27, 0.55);
    background: linear-gradient(100deg, rgba(226, 112, 27, 0.1), #191a10 60%);
  }
  .vote {
    margin: 0;
    display: flex;
  }
  .thumb {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 68px;
    padding: 10px 8px;
    background: #15160e;
    border: 1px solid rgba(237, 230, 210, 0.18);
    color: #8f9270;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .thumb:hover:not(:disabled) {
    color: #ede6d2;
    border-color: rgba(226, 112, 27, 0.6);
  }
  .thumb:disabled {
    cursor: default;
    opacity: 0.7;
  }
  .thumb--on {
    color: #15160e;
    background: #e2701b;
    border-color: #e2701b;
  }
  .thumb--on:hover:not(:disabled) {
    color: #15160e;
  }
  .thumb__icon {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .thumb__count {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
  }
  .body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    min-width: 0;
  }
  .rank {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 13px;
    letter-spacing: 0.18em;
    color: #696c46;
  }
  .text {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .author {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8f9270;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .item {
      gap: 14px;
      padding: 14px;
    }
    .thumb {
      min-width: 58px;
    }
  }
</style>
