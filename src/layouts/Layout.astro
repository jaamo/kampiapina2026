---
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Kampiapina — Morjesta pöytään",
  description = "Pyöräilyä maalta, maantieltä ja erämaasta. Kampiapina kantaa videokameraa sinne minne muut eivät jaksa polkea.",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/logo-white.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Barlow+Condensed:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Sivukohtaiset head-lisäykset, esim. vain yhdellä sivulla tarvittava fontti. -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: #15160e;
    color: #ede6d2;
    font-family: "Montserrat", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a {
    color: inherit;
  }
</style>
