# Neon-Postgres (neon.tech → oma projekti). Kopioi "pooled" connection string.
# Sama muuttuja asetetaan Netlifyn ympäristömuuttujiin.
DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Salasana /ruska/admin-sivulle. Keksi oma, pitkä.
RUSKA_ADMIN_PASSWORD=vaihda-tama

# VAIN paikallinen kehitys: neon-proxy oman Postgresin edessä. Ks. RUSKA.md.
# Tuotannossa tätä ei aseteta. Tämän kanssa DATABASE_URL on
# postgres://postgres:ruska@db.localtest.me:55432/postgres
# NEON_HTTP_ENDPOINT=http://localhost:4444/sql
